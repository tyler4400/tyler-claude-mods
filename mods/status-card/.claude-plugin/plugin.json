{
  "name": "status-card",
  "version": "0.7.2",
  "description": "输入框上方的会话摘要卡片：目标、现在、下一步、等你处理的事。跨重启保留，回看旧会话也能看到；可展开详情、折叠成胶囊。",
  "author": {
    "name": "tyler4400",
    "url": "https://github.com/tyler4400"
  },
  "license": "MIT",
  "types": "./types/index.d.ts",
  "userConfig": {
    "language": {
      "type": "string",
      "title": "摘要语言",
      "description": "auto 按你最近亲手发的消息判断中文或英文",
      "options": [
        "auto",
        "zh",
        "en"
      ],
      "default": "auto"
    },
    "model": {
      "type": "string",
      "title": "摘要模型",
      "description": "生成摘要和详情用的模型别名或完整 id",
      "default": "haiku"
    },
    "accentColor": {
      "type": "string",
      "title": "工作中颜色",
      "description": "主题色名（suggestion、claude、success、warning 等）或 #hex",
      "default": "suggestion"
    },
    "waitingColor": {
      "type": "string",
      "title": "等你处理时的颜色",
      "description": "主题色名或 #hex",
      "default": "warning"
    },
    "idleColor": {
      "type": "string",
      "title": "空闲时的颜色",
      "description": "主题色名或 #hex",
      "default": "success"
    },
    "borderStyle": {
      "type": "string",
      "title": "卡片边框",
      "options": [
        "round",
        "single",
        "bold",
        "double",
        "none"
      ],
      "default": "round",
      "description": "round 圆角、single 细线、bold 粗线、double 双线、none 无边框"
    },
    "density": {
      "type": "string",
      "title": "行距",
      "description": "comfortable 行与行之间空一行；compact 紧凑，不留空行",
      "options": [
        "comfortable",
        "compact"
      ],
      "default": "comfortable"
    },
    "showMeta": {
      "type": "boolean",
      "title": "显示轮次和时间",
      "default": true,
      "description": "卡片右上角的\"第 N 轮 · 时间\""
    },
    "retentionDays": {
      "type": "number",
      "title": "摘要保留天数",
      "description": "超过这么多天没更新的会话摘要会被清理",
      "default": 30,
      "min": 1
    }
  }
}
